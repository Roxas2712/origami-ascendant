--- /dev/null
+++ b/src/core/game3/sprite_shape.lua
@@ -0,0 +1,24 @@
+-- CPU-only silhouette metadata registered while native RGBA is available.
+-- Weak Image keys follow the native sprite caches; no ImageData/GPU readback
+-- or duplicate RGBA is retained. Coordinates match 64x64 battle portraits.
+local S={}
+local shapes=setmetatable({},{__mode='k'})
+function S.register(image,rgba,w,h)
+ if not image or w~=64 or h~=64 then return end
+ local points={};local top,bottom=64,-1
+ for y=0,63 do
+  local left,right=64,-1
+  for x=0,63 do
+   local a=rgba:byte((y*64+x)*4+4)
+   if a>=3 then left=math.min(left,x);right=x end
+   if a>=128 then top=math.min(top,y);bottom=y end
+  end
+  if right>=left then
+   points[#points+1]={left-32,y-32};points[#points+1]={right+1-32,y-32}
+   points[#points+1]={left-32,y+1-32};points[#points+1]={right+1-32,y+1-32}
+  end
+ end
+ shapes[image]={outline=points,metrics=bottom>=top and {bottom=bottom+1,height=bottom-top+1}or {bottom=56,height=48}}
+end
+function S.get(image)return shapes[image]end
+return S
