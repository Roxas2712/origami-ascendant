+-- Explicit loading-phase preparation. Use the same cache and animation binding
+-- as the eventual map; never change the current map or request unrelated pairs.
+function NativeTileset.prepareMaps(maps, ids)
+  local seen, count = {}, 0
+  for _, id in ipairs(ids or {}) do
+    local def = maps and maps[id]
+    local pair = def and def.pair
+    if type(pair) == "string" and not seen[pair] then
+      seen[pair] = true
+      if NativeTileset.ready(pair) then
+        local ok, atlas = pcall(NativeTileset.get, pair)
+        if ok and atlas then count = count + 1 end
+      end
+    end
+  end
+  return count
+end
+
 function NativeTileset.ready(pair)
   if not Versions.NATIVE_RENDER then return false end
   if not pair then return false end
