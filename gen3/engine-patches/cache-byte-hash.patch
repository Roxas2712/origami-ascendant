+-- Engine-owned SHA-256 for byte strings; never exposes FFI to mods.
+-- macOS system crypto is optional; all other platforms retain LÖVE's hash.
+local M={};local initialized,systemHash,backend=false,nil,'love'
+local function initialize()
+ if initialized then return end;initialized=true
+ if love.system.getOS()~='OS X'then return end
+ local ok,fn=pcall(function()
+  local ffi=require('ffi')
+  ffi.cdef('unsigned char *CC_SHA256(const void *data, unsigned int len, unsigned char *md);')
+  local crypto=ffi.load('/usr/lib/system/libcommonCrypto.dylib')
+  local buffer=ffi.new('unsigned char[32]')
+  local function digest(raw)
+   assert(crypto.CC_SHA256(raw,#raw,buffer)~=nil,'system SHA-256 failed')
+   return ffi.string(buffer,32)
+  end
+  -- Check the actual backend, including empty input and a multi-block binary
+  -- value, before allowing it to validate any cached geometry or source file.
+  for _,raw in ipairs{'','abc',string.rep('\0\255\128',67)}do
+   assert(digest(raw)==love.data.hash('sha256',raw),'system SHA-256 self-test')
+  end
+  return digest
+ end)
+ if ok then systemHash=fn;backend='macos-commoncrypto'end
+end
+function M.sha256(raw)
+ assert(type(raw)=='string','cache hash expects byte string')
+ initialize()
+ local digest
+ if systemHash and #raw<=4294967295 then
+  local ok,result=pcall(systemHash,raw)
+  if ok then digest=result else systemHash=nil;backend='love'end
+ end
+ return love.data.encode('string','hex',digest or love.data.hash('sha256',raw))
+end
+function M.backend()initialize();return backend end
+return M
