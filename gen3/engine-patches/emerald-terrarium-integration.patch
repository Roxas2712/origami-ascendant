diff --git a/src/core/game3/scripting/ops_a.lua b/src/core/game3/scripting/ops_a.lua
index c37446e..c7819ca 100644
--- a/src/core/game3/scripting/ops_a.lua
+++ b/src/core/game3/scripting/ops_a.lua
@@ -251,6 +251,24 @@ local function set_map_layout(layoutId, log)
   local root = Extract.NATIVE_ROOT
     or ((Extract.CACHE_ROOT or "data/generated/gba") .. "/native")
   local blob = Dataset.cache():read(root .. "/layouts/alt_" .. layoutId .. ".mid")
+  -- Layouts shared by an existing map (e.g. Shoal high/low tide) are
+  -- already baked under that map's name. Older caches omit alt_<id>.mid.
+  -- Use the imported header ID and untouched cached cells, never another
+  -- live map's overrides. No ROM-cache mutation or synthetic tiles.
+  if not blob then
+    local candidates = {}
+    for id, candidate in pairs(game.data.maps or {}) do
+      if candidate.layoutId == layoutId and candidate.pair == def.pair
+          and type(candidate.nativeLayoutFile) == "string" then
+        candidates[#candidates + 1] = id
+      end
+    end
+    table.sort(candidates)
+    for _, id in ipairs(candidates) do
+      blob = Dataset.cache():read(root .. "/" .. game.data.maps[id].nativeLayoutFile)
+      if blob then break end
+    end
+  end
   if not blob then
     if log then log("[game3] setmaplayoutindex " .. layoutId .. ": no baked layout") end
     return false
