+-- Run before the boot menu/field becomes interactive, never at a battle boundary.
+local M={}
+function M.prepare(Audio, opts)
+  local started=love.timer and love.timer.getTime() or 0
+  local last=-math.huge
+  local function progress(i,total)
+    local g=love.graphics
+    if not(g and g.isActive and g.isActive() and love.timer)then return end
+    local now=love.timer.getTime();if now-last<.1 and i~=total then return end;last=now
+    g.push('all');g.setCanvas();g.origin();g.setShader();g.setScissor();g.setDepthMode()
+    g.clear(.055,.08,.10,1);g.setColor(.9,.94,.9,1)
+    local w,h=g.getDimensions()
+    g.printf('Preparing battle effects...',0,h*.45,w,'center')
+    local width=math.min(360,w*.6);g.setColor(.2,.27,.3,1);g.rectangle('fill',(w-width)/2,h*.52,width,8)
+    g.setColor(.65,.82,.65,1);g.rectangle('fill',(w-width)/2,h*.52,width*i/math.max(1,total),8)
+    g.pop();g.present();if love.event then love.event.pump()end
+  end
+  progress(0,1)
+  require('src.core.game3.battle.anim').scriptForMove(1)
+  require('src.core.game3.battle.anim_templates')
+  require('src.core.game3.battle.anim_callbacks')
+  -- These tables are otherwise required from the first particle callback.
+  require('src.core.game3.battle.anim_port.g1_templates')
+  require('src.core.game3.battle.anim_port.g2_templates')
+  local n=Audio.prepareAllSe(opts,progress)
+  local archive=Audio._seArchive
+  print('BATTLE_LOADING_READY',n,archive and archive.hits or 0,archive and archive.misses or 0,
+    archive and archive.bytes or 0,love.timer and (love.timer.getTime()-started)*1000 or 0)
+  return n
+end
+return M
