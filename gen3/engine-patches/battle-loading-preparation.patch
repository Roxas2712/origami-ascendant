+-- Disposable, lossless SE synthesis cache. Native sequencing and playback remain
+-- in audio.lua; this stores only default-option waveforms, never game state.
+local C = { VERSION = 'OASCSE02', MAX_MEMORY = 64 * 1024 * 1024 }
+local okFfi, ffi = pcall(require, 'ffi')
+local function digest(s) return love.data.hash('sha256', s) end
+local function hex(s) return (s:gsub('.', function(c) return string.format('%02x', c:byte()) end)) end
+local function validId(id) return type(id)=='number' and id>=0 and id<=65535 and id==math.floor(id) end
+function C.encode(w, rate)
+  if not okFfi or type(w.rawL)~='table' or type(w.rawR)~='table' then return end
+  local n=#w.rawL
+  if n<1 or n~=#w.rawR or n>rate*30 then return end
+  local values=ffi.new('double[?]',n*2)
+  for i=1,n do values[(i-1)*2]=w.rawL[i];values[(i-1)*2+1]=w.rawR[i] end
+  local raw=ffi.string(values,n*16)
+  return C.VERSION..(ffi.abi('le') and 'L' or 'B')..(w.loop and '1' or '0')
+    ..love.data.pack('string','<I4I4I4',rate,n,w.loopStart or 4294967295)
+    ..digest(raw)..love.data.compress('string','lz4',raw,1)
+end
+function C.decode(blob, rate)
+  assert(okFfi and type(blob)=='string' and #blob>=55 and #blob<50*1024*1024,'invalid SE record')
+  assert(blob:sub(1,8)==C.VERSION and blob:sub(9,9)==(ffi.abi('le') and 'L' or 'B'),'SE cache format')
+  local loop=blob:sub(10,10);assert(loop=='0' or loop=='1','SE loop flag')
+  local stored,n,start=love.data.unpack('<I4I4I4',blob,11)
+  assert(stored==rate and n>=1 and n<=rate*30 and (start==4294967295 or start<=n),'SE cache dimensions')
+  assert(love.data.unpack('<I4',blob,55)==n*16,'SE cache allocation size')
+  local raw=love.data.decompress('string','lz4',blob:sub(55))
+  assert(#raw==n*16 and digest(raw)==blob:sub(23,54),'SE cache checksum')
+  -- Copy to aligned memory before reading doubles, including on ARM.
+  local values=ffi.new('double[?]',n*2);ffi.copy(values,raw,#raw)
+  local L,R={},{}
+  for i=1,n do L[i]=values[(i-1)*2];R[i]=values[(i-1)*2+1] end
+  return {rawL=L,rawR=R,loop=loop=='1',loopStart=start~=4294967295 and start or nil}
+end
+function C.open(pack, cache, rate)
+  if not(okFfi and love and love.data and love.filesystem and pack and cache and cache.read) then return end
+  local ids={}
+  for id,info in pairs(pack.index.songs or {})do
+    id=tonumber(id)
+    if validId(id) and info.kind=='se' then ids[#ids+1]=id end
+  end
+  table.sort(ids)
+  local pieces={C.VERSION,tostring(rate),ffi.abi('le') and 'le' or 'be',pack.root}
+  local function include(raw) assert(type(raw)=='string','missing cache source');pieces[#pieces+1]=digest(raw) end
+  for _,name in ipairs{'audio','se_wave_cache','m4a_player','m4a_mix','m4a_seq','m4a_sample','se_ids'}do
+    include(love.filesystem.read('src/core/game3/'..name..'.lua'))
+  end
+  include(cache:read(pack.root..'/index.lua'));include(pack.samplesBin)
+  for _,name in ipairs{'samples.lua','voicegroups.lua'}do pieces[#pieces+1]=digest(cache:read(pack.root..'/'..name) or '') end
+  -- A changed imported song invalidates the archive even with an identical ROM label.
+  for _,id in ipairs(ids)do include(cache:read(string.format('%s/songs/%d.bin',pack.root,id))) end
+  local path='cache/firered-se/'..hex(digest(table.concat(pieces,'\0')))
+  local self={path=path,rate=rate,ids=ids,blobs={},bytes=0,hits=0,misses=0,invalid=0,writes=0}
+  local function remember(id,blob)
+    if not self.blobs[id] and self.bytes+#blob<=C.MAX_MEMORY then self.blobs[id]=blob;self.bytes=self.bytes+#blob end
+  end
+  function self:get(id)
+    if not validId(id)then return end
+    local blob=self.blobs[id]
+    if not blob then blob=love.filesystem.read(self.path..'/'..id..'.bin') end
+    if blob then
+      local ok,w=pcall(C.decode,blob,self.rate)
+      if ok then remember(id,blob);self.hits=self.hits+1;return w end
+      if self.blobs[id]then self.bytes=self.bytes-#self.blobs[id];self.blobs[id]=nil end
+      self.invalid=self.invalid+1
+    end
+    self.misses=self.misses+1
+  end
+  function self:put(id,w)
+    if not validId(id)then return end
+    local ok,blob=pcall(C.encode,w,self.rate);if not(ok and blob)then return end
+    remember(id,blob)
+    -- Writes are best-effort and atomic. Missing permissions/corrupt files never
+    -- prevent native synthesis or boot; a later run can simply regenerate them.
+    pcall(function()
+      if not love.filesystem.createDirectory(self.path)then return end
+      local rel=self.path..'/'..id..'.bin'
+      if love.filesystem.write(rel..'.tmp',blob)then
+        if os.rename(love.filesystem.getSaveDirectory()..'/'..rel..'.tmp',love.filesystem.getSaveDirectory()..'/'..rel)then self.writes=self.writes+1 end
+      end
+    end)
+  end
+  return self
+end
+return C
