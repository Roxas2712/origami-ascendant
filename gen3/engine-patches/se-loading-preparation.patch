+-- Call only during explicit game loading, never from update/map transitions.
+-- Preparation is bounded by the existing raw LRU and does not start any source.
+function Audio.prepareSe(ids, opts)
+  opts = opts or {}
+  local count = 0
+  if not Audio.isReady() then return count end
+  for _, name in ipairs(ids or {}) do
+    local id = SE.resolve(name)
+    local info = id and Audio.songInfo(id)
+    if info and info.kind ~= "fanfare" then
