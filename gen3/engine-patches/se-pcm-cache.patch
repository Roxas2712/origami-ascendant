+-- Keep one PCM variant per raw-cache entry. The raw-frame LRU bounds this to
+-- at most SE_RAW_MAX_FRAMES * 4 bytes (stereo 16-bit); option changes replace
+-- the variant instead of growing an unbounded pan/volume cache. Install and
+-- endSession clear the owning raw cache. Sources remain independent per play.
+function Audio._preparedSeSoundData(entry, L, R, master, pan, mono)
+  mono = mono and true or false
+  local pcm = entry and entry.pcm
+  if pcm and pcm.master == master and pcm.pan == pan and pcm.mono == mono
+    and pcm.rate == Mix.SAMPLE_RATE then
+    return pcm.data
+  end
+  local data = Audio._buildSeSoundData(L, R, master, pan, mono)
+  if entry and data then
+    entry.pcm = { data = data, master = master, pan = pan, mono = mono, rate = Mix.SAMPLE_RATE }
+  end
+  return data
 end
 
